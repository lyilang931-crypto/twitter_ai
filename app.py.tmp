    elif target == "強めE120桁E":
        per_role = 40
        calls_plan = 3
    else:
        per_role = 25
        calls_plan = 6  # 2回に刁E��して150相当！EPD皁E��ギリ余裕！E

    st.caption("※、E00案』�E“�E部リーグ200局”で代替�E�速い�E�E��限踏まなぁE��、E)

    st.subheader("レーチE��ング")
    baseline = st.slider("Baseline�E�勝玁E��準！E, 0.40, 0.70, 0.50, 0.01)
    k_abs = st.slider("K�E�絶対�E�E, 4.0, 32.0, 16.0, 1.0)
    k_rel = st.slider("K�E�相対�E�E, 4.0, 32.0, 16.0, 1.0)

# =========================
# Tabs
# =========================
tab1, tab2, tab3 = st.tabs(["① 生�E→�E己対局→承誁E3チE��)", "② 実測入劁E手�E力最封ECSV可)", "③ 刁E��・学翁E重み/レーチE"])

# =========================================================
# ① 生�E→�E己対局→承誁E
# =========================================================
with tab1:
    st.subheader("今日のチE�Eマ（あなたっぽさ：�E酷×設計×起業×経済！E)
    topic = st.text_input("チE�EチE, value="起業で失敗する人の共通点�E�努力ではなく設計�E問題！E)

    if st.button("生�E�E�制限回避�E��E 冁E��自己対局 ↁE上位を提示"):
        if not usage_can_call(usage):
            st.error("本日のRPD上限に到達。�E日また回してください、E)
            st.stop()

        st.info("生�E開始：途�Eれ防止・JSON強制・レート制限征E��を自動で行います、E)

        all_main: list[str] = []
        all_sub: list[str] = []
        all_exp: list[str] = []

        def gen_role(role: str, n_each: int) -> list[str]:
            # RPMを守る
            rl.wait_for_rpm()
            texts = api_generate(role, topic, trend_hint, n_each, api_key, model)
            return texts

        # ===== 生�E�E�Ealls_plan に応じて回す�E�E====
        rounds = 1 if calls_plan == 3 else 2
        for _ in range(rounds):
            # MAIN
            if usage_can_call(usage):
                all_main.extend(gen_role("MAIN", per_role))
                usage_inc(usage, 1); save_json(U_PATH, usage)

            # SUB
            if usage_can_call(usage):
                all_sub.extend(gen_role("SUB", per_role))
                usage_inc(usage, 1); save_json(U_PATH, usage)

            # EXP
            if usage_can_call(usage):
                all_exp.extend(gen_role("EXP", per_role))
                usage_inc(usage, 1); save_json(U_PATH, usage)

        # 重褁E��去
        def uniq(xs: list[str]) -> list[str]:
            seen = set()
            out = []
            for x in xs:
                if x not in seen:
                    out.append(x)
                    seen.add(x)
            return out

        all_main, all_sub, all_exp = uniq(all_main), uniq(all_sub), uniq(all_exp)

        # 候裁EↁE擬似採点
        main_c = build_candidates(rows, w, "MAIN", all_main)
        sub_c  = build_candidates(rows, w, "SUB", all_sub)
        exp_c  = build_candidates(rows, w, "EXP", all_exp)

        # 冁E��自己対局�E�E00局相当！E
        main_c = league_score(main_c, rounds=200)
        sub_c  = league_score(sub_c, rounds=200)
        exp_c  = league_score(exp_c, rounds=200)

        st.session_state["pack"] = {"MAIN": main_c, "SUB": sub_c, "EXP": exp_c}
        st.success("生�E完亁E��上位候補を表示します、E)
        

    pack = st.session_state.get("pack")
    if pack:
        st.caption("上位�E『擬似報酬×EXP刁E��スコア×�E己対局』で選抜。安�EぁEのも�Eは自動で落ちます、E)

        def show_role(role, title):
            st.markdown(f"## {title}")
            cands = pack.get(role, [])[:10]
            for i, c in enumerate(cands, start=1):
                with st.expander(f"#{i}  league={c.get('league',0):.3f}  pseudo={c.get('pseudo',0):.3f}  {c['text'][:30]}..."):
                    st.write(c["text"])
                    st.write({
                        "safety": c["safety"],
                        "novelty": round(c["novelty"], 3),
                        "tail": round(c["tail"], 3),
                        "pseudo": round(c["pseudo"], 3),
                        "league": round(c.get("league", 0.0), 3),
                    })
                    if c["safety"] <= 0.0:
                        st.warning("Safety=0�E�危険判定（�E動�EチE��E)
                    st.code(c["text"], language=None)

        show_role("MAIN", "朁E7-9) MAIN�E�本命�E�否定×断定！E)
        show_role("SUB", "昼(12-13) SUB�E�準本命�E�否定×数孁E比輁E��E)
        show_role("EXP", "夁E20-22) EXP�E�実験（質問×送E�� / 刁E��最大化！E)

        st.markdown("## ✁E承認（今日の3チE���E�E)
        col1, col2, col3 = st.columns(3)

        def pick(role, idx_key):
            cands = pack.get(role, [])
            if not cands:
                return None
            idx = st.number_input(idx_key, min_value=1, max_value=min(10, len(cands)), value=1, step=1)
            return cands[int(idx)-1]

        with col1:
            a_main = pick("MAIN", "MAINの採用頁E��E1-10)")
        with col2:
            a_sub = pick("SUB", "SUBの採用頁E��E1-10)")
        with col3:
            a_exp = pick("EXP", "EXPの採用頁E��E1-10)")

        if st.button("こ�E3つを承認して保存（投稿用に固定！E):
            approved = {"MAIN": a_main, "SUB": a_sub, "EXP": a_exp}
            st.session_state["approved"] = approved
            st.success("承認保存しました。②で実測入力へ、E)
            for k, v in approved.items():
                st.markdown(f"**{k}**")
                st.code(v["text"])

# =========================================================
# ② 実測入力（手入力最封ECSV可�E�E
# =========================================================
with tab2:
    st.subheader("実測入力：速報→確定（手入力最小！E)
    approved = st.session_state.get("approved", {})

    role_pick = st.selectbox("対象�E�役割�E�E, ["MAIN","SUB","EXP"], index=0)
    default_text = (approved.get(role_pick) or {}).get("text", "")

    st.caption("最小�E力：tweet_id(任愁E + インプレ/ぁE��ね/RT/返信 + フォロワー前後（確定スコア用�E�E)
    text = st.text_area("投稿斁E��コピ�E�E�E, value=default_text, height=120)
    tweet_id = st.text_input("tweet_id�E�任意！E, value="")

    c1, c2, c3 = st.columns(3)
    with c1:
        impr = st.number_input("インプレチE��ョン", min_value=0, value=0, step=1)
        likes = st.number_input("ぁE��ね", min_value=0, value=0, step=1)
    with c2:
        rts = st.number_input("RT", min_value=0, value=0, step=1)
        replies = st.number_input("返信", min_value=0, value=0, step=1)
    with c3:
        fol_before = st.number_input("フォロワー�E�前�E�E, min_value=0, value=0, step=1)
        fol_after = st.number_input("フォロワー�E�後！E, min_value=0, value=0, step=1)

    # 自動採点�E�擬似�E�E
    saf = safety_score_01(text)
    nov = novelty_score(text, rows, window=300)
    tail = tail_score(text)
    comps = pseudo_reward_components(text, novelty=nov, safety=saf, tail=tail)
    ps = pseudo_score(comps, w)
    if role_pick == "EXP":
        ps = 0.35 * ps + 0.65 * exp_utility(tail=tail, novelty=nov, safety=saf)

    s速報 =速報_score(int(impr), int(likes), int(rts), int(replies))
    s確宁E=確定_score(int(impr), int(likes), int(rts), int(replies), int(fol_before), int(fol_after))

    st.write("### 自動採点")
    st.write({
        "Pseudo(擬似)": round(ps, 3),
        "速報": round(s速報, 3),
        "確宁E: round(s確宁E 3),
        "novelty": round(nov, 3),
        "safety": saf,
        "tail": round(tail, 3),
    })

    if st.button("保存（棋譜に追加�E�！E重み学習（擬似↔確定ズレ�E�！Eレート更新"):

        # 学習：擬似→確定�Eズレで重み更新
        y_true = float(s確宁E
        y_pred = float(ps)
        w = sgd_update(w, comps, y_true=y_true, y_pred=y_pred, lr=0.35, l2=0.0005)
        save_weights(W_PATH, w)

        # レート更新�E�絶対/相対�E�E
        abs_before = abs_rating
        rel_before = rel_rating

        abs_rating = elo_update(abs_rating, score01=y_true, baseline=float(baseline), k=float(k_abs))
        # 相対�E��E刁E�E最近平坁E��簡易！E
        tail_rows = rows[-30:] if len(rows) > 30 else rows
        if tail_rows:
            recent_mean = sum(float(r.get("確宁E, 0) or 0) for r in tail_rows) / max(1, len(tail_rows))
        else:
            recent_mean = 0.50
        rel_rating = elo_update(rel_rating, score01=y_true, baseline=float(recent_mean), k=float(k_rel))

        row = {
            "date": str(date.today()),
            "role": role_pick,
            "tweet_id": tweet_id,
            "text": text.strip(),
            "impressions": int(impr),
            "likes": int(likes),
            "rts": int(rts),
            "replies": int(replies),
            "followers_before": int(fol_before),
            "followers_after": int(fol_after),
            "Pseudo": f"{ps:.6f}",
            "速報": f"{s速報:.6f}",
            "確宁E: f"{s確宁E.6f}",
            "novelty": f"{nov:.6f}",
            "safety": f"{saf:.0f}",
            "tail": f"{tail:.6f}",
            "abs_rating_before": f"{abs_before:.2f}",
            "abs_rating_after": f"{abs_rating:.2f}",
            "rel_rating_before": f"{rel_before:.2f}",
            "rel_rating_after": f"{rel_rating:.2f}",
        }
        append_row(LOG_PATH, row)
        rows = read_rows(LOG_PATH)

        st.success("保存！E��習しました。次の生�Eから“擬似評価の精度”が上がります、E)
        st.info(f"Abs: {abs_before:.1f} ↁE{abs_rating:.1f} / Rel: {rel_before:.1f} ↁE{rel_rating:.1f}")

    st.markdown("---")
    st.subheader("CSV一括取り込み�E�手入力削減！E)
    up = st.file_uploader("Xの刁E��CSV�E�任意！E, type=["csv"])
    if up is not None:
        df = pd.read_csv(up)
        st.dataframe(df.head(20), use_container_width=True)
        st.caption("列名が違ってもOK。忁E���Eを選んでマッピングしてください、E)
        cols = list(df.columns)

        map_id = st.selectbox("tweet_id刁E, ["(なぁE"] + cols, index=0)
        map_text = st.selectbox("text刁E, ["(なぁE"] + cols, index=0)
        map_impr = st.selectbox("impressions刁E, ["(なぁE"] + cols, index=0)
        map_likes = st.selectbox("likes刁E, ["(なぁE"] + cols, index=0)
        map_rts = st.selectbox("rts刁E, ["(なぁE"] + cols, index=0)
        map_replies = st.selectbox("replies刁E, ["(なぁE"] + cols, index=0)
        map_fol_b = st.selectbox("followers_before刁E, ["(なぁE"] + cols, index=0)
        map_fol_a = st.selectbox("followers_after刁E, ["(なぁE"] + cols, index=0)
        map_role = st.selectbox("role刁E任愁E", ["(なぁE"] + cols, index=0)

        if st.button("CSVを�E動学習（擬似↔確定ズレで重み更新�E�E):
            learned = 0
            for _, r in df.iterrows():
                txt = str(r[map_text]) if map_text != "(なぁE" else ""
                if not txt:
                    continue
                impr = int(r[map_impr]) if map_impr != "(なぁE" else 0
                likes = int(r[map_likes]) if map_likes != "(なぁE" else 0
                rts = int(r[map_rts]) if map_rts != "(なぁE" else 0
                replies = int(r[map_replies]) if map_replies != "(なぁE" else 0
                fb = int(r[map_fol_b]) if map_fol_b != "(なぁE" else 0
                fa = int(r[map_fol_a]) if map_fol_a != "(なぁE" else 0

                saf = safety_score_01(txt)
                nov = novelty_score(txt, rows, window=300)
                tail = tail_score(txt)
                comps = pseudo_reward_components(txt, novelty=nov, safety=saf, tail=tail)
                ps = pseudo_score(comps, w)
                y_true = float(確定_score(impr, likes, rts, replies, fb, fa))
                w = sgd_update(w, comps, y_true=y_true, y_pred=ps, lr=0.25, l2=0.0005)
                learned += 1

            save_weights(W_PATH, w)
            st.success(f"CSVから学習完亁E {learned}件")
            st.info("次回生成から精度が上がります、E)

# =========================================================
# ③ 刁E��・学習（重み/レート！E
# =========================================================
with tab3:
    st.subheader("レーチE��ング & 学習状慁E)
    colA, colB, colC = st.columns(3)
    colA.metric("Abs Rating", f"{abs_rating:.1f}")
    colB.metric("Rel Rating", f"{rel_rating:.1f}")
    colC.metric("Weights更新日", str(date.today()))

    st.write("### 学習中の重み�E�擬似→確定�E当たり方�E�E)
    st.json(w)

    if rows:
        df = pd.DataFrame(rows)
        for c in ["Pseudo","速報","確宁E,"novelty","tail","abs_rating_after","rel_rating_after"]:
            if c in df.columns:
                df[c] = pd.to_numeric(df[c], errors="coerce")
        st.write("### 最近�E棋譜！E0件�E�E)
        st.dataframe(df.tail(30), use_container_width=True)

        st.caption("見方�E�Pseudoが確定に寁E��てきたら『疑似報酬が賢くなった』＝趁E��速学習が成立、E)
    else:
        st.warning("まだ棋譜がありません。②で1件入れると学習が始まります、E)
