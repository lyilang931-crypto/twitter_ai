    st.subheader("候補数�E��E動最適�E�E)
    # 制限と速度を最優先。デフォは90案！E回ÁE0�E�E
    target = st.selectbox("候補規模", ["最送E90桁E", "強めE120桁E", "重め(150桁E"], index=0)
    if target == "最送E90桁E":
        per_role = 30
